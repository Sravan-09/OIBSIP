# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Virtual environments
venv/
env/
ENV/
.env

# Data files (Exclude raw datasets from git tracking)
data/raw/*.csv
data/raw/*.xlsx
data/raw/*.json
data/raw/*.zip
!data/raw/.gitkeep
!data/raw/README.md

# Processed data outputs
data/processed/*.csv
!data/processed/.gitkeep

# Operating system files
.DS_Store
Thumbs.db

# IDE settings
.vscode/
.idea/
